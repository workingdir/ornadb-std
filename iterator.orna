// Iterators are persistent pull cursors. Creating or composing one does no
// traversal; `next` requests one value and returns a new cursor. Pulling the
// same cursor again replays its computation, including callback calls, so use
// pure callbacks when repeatable observations are required. These in-memory
// iterators do not wait, checkpoint, or perform stream-provider work.
pub enum Iterator<T> {
    Deferred { pull: fn(): (T?, Iterator<T>) },
}

pub fn empty<T>(): Iterator<T> = Iterator.Deferred {
    pull: () => (null, empty()),
};

pub fn next<T>(iterator: Iterator<T>): (T?, Iterator<T>) = case iterator {
    Iterator.Deferred { pull }: pull(),
};

fn list_pull<T>(values: [T], start_index: Int): (T?, Iterator<T>) =
    case std.collection.first(std.collection.drop(values, start_index)) {
        Some(value): (
            first([value]),
            Iterator.Deferred { pull: () => list_pull(values, start_index + 1) },
        ),
        null: (null, empty()),
    };

pub fn from_list<T>(values: [T]): Iterator<T> = Iterator.Deferred {
    pull: () => list_pull(values, 0),
};

// Infinite sources stay productive: the successor is computed only when the
// following cursor is pulled. Use `take` before `collect` on an infinite source.
pub fn iterate<T>(seed: T, successor: fn(T): T): Iterator<T> = Iterator.Deferred {
    pull: () => (
        first([seed]),
        Iterator.Deferred {
            pull: () => next(iterate(successor(seed), successor)),
        },
    ),
};

pub fn repeat<T>(value: T): Iterator<T> = Iterator.Deferred {
    pull: () => (first([value]), repeat(value)),
};

fn map_pull<T, U>(source: Iterator<T>, transform: fn(T): U): (U?, Iterator<U>) =
    case next(source) {
        (Some(value), tail): (
            first([transform(value)]),
            Iterator.Deferred { pull: () => map_pull(tail, transform) },
        ),
        (null, _): (null, empty()),
    };

pub fn map<T, U>(source: Iterator<T>, transform: fn(T): U): Iterator<U> =
    Iterator.Deferred { pull: () => map_pull(source, transform) };

fn chain_pull<T>(left: Iterator<T>, right: Iterator<T>): (T?, Iterator<T>) =
    case next(left) {
        (Some(value), tail): (
            first([value]),
            Iterator.Deferred { pull: () => chain_pull(tail, right) },
        ),
        (null, _): next(right),
    };

// Pulls every item from left before requesting an item from right.
pub fn chain<T>(left: Iterator<T>, right: Iterator<T>): Iterator<T> =
    Iterator.Deferred { pull: () => chain_pull(left, right) };

fn enumerate_pull<T>(source: Iterator<T>, index: Int): ((Int, T)?, Iterator<(Int, T)>) =
    case next(source) {
        (Some(value), tail): (
            first([(index, value)]),
            Iterator.Deferred { pull: () => enumerate_pull(tail, index + 1) },
        ),
        (null, _): (null, empty()),
    };

// Enumeration starts at zero and advances once per emitted item.
pub fn enumerate<T>(source: Iterator<T>): Iterator<(Int, T)> =
    Iterator.Deferred { pull: () => enumerate_pull(source, 0) };

fn filter_pull<T>(source: Iterator<T>, predicate: fn(T): Bool): (T?, Iterator<T>) =
    case next(source) {
        (Some(value), tail) if predicate(value): (
            first([value]),
            Iterator.Deferred { pull: () => filter_pull(tail, predicate) },
        ),
        (Some(_), tail): filter_pull(tail, predicate),
        (null, _): (null, empty()),
    };

pub fn filter<T>(source: Iterator<T>, predicate: fn(T): Bool): Iterator<T> =
    Iterator.Deferred { pull: () => filter_pull(source, predicate) };

fn take_pull<T>(source: Iterator<T>, remaining: Int): (T?, Iterator<T>) =
    if remaining == 0 {
        (null, empty())
    } else {
        case next(source) {
            (Some(value), tail): (
                first([value]),
                Iterator.Deferred { pull: () => take_pull(tail, remaining - 1) },
            ),
            (null, _): (null, empty()),
        }
    };

pub fn take<T>(source: Iterator<T>, count: Int): Iterator<T> =
    if count < 0 {
        fail(error(code: "std.iterator.negative_count", message: "iterator count must be nonnegative"))
    } else {
        Iterator.Deferred { pull: () => take_pull(source, count) }
    };

fn drop_pull<T>(source: Iterator<T>, remaining: Int): (T?, Iterator<T>) =
    if remaining == 0 {
        next(source)
    } else {
        case next(source) {
            (Some(_), tail): drop_pull(tail, remaining - 1),
            (null, _): (null, empty()),
        }
    };

pub fn drop<T>(source: Iterator<T>, count: Int): Iterator<T> =
    if count < 0 {
        fail(error(code: "std.iterator.negative_count", message: "iterator count must be nonnegative"))
    } else {
        Iterator.Deferred { pull: () => drop_pull(source, count) }
    };

fn collect_into<T>(source: Iterator<T>, collected: [T]): [T] =
    case next(source) {
        (Some(value), tail): collect_into(tail, std.collection.union(collected, [value])),
        (null, _): collected,
    };

// Terminal operation. Finite iterators are required; infinite ones should be
// bounded with `take` before collection.
pub fn collect<T>(source: Iterator<T>): [T] = collect_into(source, []);

fn fold_from<T, U>(source: Iterator<T>, accumulator: U, combine: fn(U, T): U): U =
    case next(source) {
        (Some(value), tail): fold_from(tail, combine(accumulator, value), combine),
        (null, _): accumulator,
    };

// Folds a finite iterator from left to right; an infinite source does not terminate.
pub fn fold<T, U>(source: Iterator<T>, initial: U, combine: fn(U, T): U): U =
    fold_from(source, initial, combine);

pub fn first<T>(source: Iterator<T>): T? = case next(source) {
    (Some(value), _): first([value]),
    (null, _): null,
};

fn nth_from<T>(source: Iterator<T>, index: Int): T? =
    if index == 0 {
        first(source)
    } else {
        case next(source) {
            (Some(_), tail): nth_from(tail, index - 1),
            (null, _): null,
        }
    };

pub fn nth<T>(source: Iterator<T>, index: Int): T? =
    if index < 0 {
        fail(error(code: "std.iterator.negative_index", message: "iterator index must be nonnegative"))
    } else {
        nth_from(source, index)
    };
