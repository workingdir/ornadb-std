// Process launch is an explicit host effect. Executable and argument strings
// stay separate, and callers provide the working directory and complete child
// environment. A null stdin closes immediately; a positive output bound
// applies to stdout plus stderr. Timeouts terminate and join the child before
// reporting failure. No shell, CWD, or ambient environment is inherited.

pub fn run(
    executable: Str,
    arguments: [Str],
    working_directory: Str,
    environment: [(Str, Str)],
    input: Blob?,
    timeout: Duration?,
    max_output_bytes: Int,
): (Int?, Blob, Blob) = __run(
    executable, arguments, working_directory, environment, input, timeout, max_output_bytes
);

fn __run(
    executable: Str,
    arguments: [Str],
    working_directory: Str,
    environment: [(Str, Str)],
    input: Blob?,
    timeout: Duration?,
    max_output_bytes: Int,
): (Int?, Blob, Blob) = std.io.process.run(
    executable, arguments, working_directory, environment, input, timeout, max_output_bytes
);
