// These functions cross the evaluator's registered filesystem effect
// boundary. The root and path are explicit, and each operation receives a
// host-installed provider with canonical containment and resource limits.
// Writes never create parent directories implicitly; overwrite behavior is an
// explicit argument. Effects are unavailable to assertions, read-only
// watches, presenters, and historical evaluation.

pub fn read_text(root: Str, path: Str): Str = __read_text(root, path);
fn __read_text(root: Str, path: Str): Str = std.io.fs.read_text(root, path);

// An empty file contains no lines. For nonempty files, split on LF and
// preserve blank fields, including the final empty field after a terminal LF.
pub fn read_lines(root: Str, path: Str): [Str] {
    let contents = read_text(root, path);
    if contents == "" {
        []
    } else {
        std.text.split(contents, "\n")
    }
}

pub fn write_text(root: Str, path: Str, contents: Str, overwrite: Bool): Unit =
    __write_text(root, path, contents, overwrite);
fn __write_text(root: Str, path: Str, contents: Str, overwrite: Bool): Unit =
    std.io.fs.write_text(root, path, contents, overwrite);

pub fn append_text(root: Str, path: Str, contents: Str): Unit =
    __append_text(root, path, contents);
fn __append_text(root: Str, path: Str, contents: Str): Unit =
    std.io.fs.append_text(root, path, contents);

pub fn exists(root: Str, path: Str): Bool = __exists(root, path);
fn __exists(root: Str, path: Str): Bool = std.io.fs.exists(root, path);

pub fn is_directory(root: Str, path: Str): Bool = __is_directory(root, path);
fn __is_directory(root: Str, path: Str): Bool = std.io.fs.is_directory(root, path);

pub fn metadata(root: Str, path: Str): (Str, Int?, Instant?, Instant?) = __metadata(root, path);
fn __metadata(root: Str, path: Str): (Str, Int?, Instant?, Instant?) = std.io.fs.metadata(root, path);

pub fn symlink_metadata(root: Str, path: Str): (Str, Int?, Instant?, Instant?) =
    __symlink_metadata(root, path);
fn __symlink_metadata(root: Str, path: Str): (Str, Int?, Instant?, Instant?) =
    std.io.fs.symlink_metadata(root, path);

pub fn list(root: Str, path: Str): [Str] = __list(root, path);
fn __list(root: Str, path: Str): [Str] = std.io.fs.list(root, path);

pub fn create_dir(root: Str, path: Str, parents: Bool, exist_ok: Bool): Unit =
    __create_dir(root, path, parents, exist_ok);
fn __create_dir(root: Str, path: Str, parents: Bool, exist_ok: Bool): Unit =
    std.io.fs.create_dir(root, path, parents, exist_ok);

pub fn remove_file(root: Str, path: Str): Unit = __remove_file(root, path);
fn __remove_file(root: Str, path: Str): Unit = std.io.fs.remove_file(root, path);

pub fn copy_file(root: Str, source_path: Str, destination_path: Str, overwrite: Bool): Unit =
    __copy_file(root, source_path, destination_path, overwrite);
fn __copy_file(root: Str, source_path: Str, destination_path: Str, overwrite: Bool): Unit =
    std.io.fs.copy_file(root, source_path, destination_path, overwrite);

pub fn move_file(root: Str, source_path: Str, destination_path: Str, overwrite: Bool): Unit =
    __move_file(root, source_path, destination_path, overwrite);
fn __move_file(root: Str, source_path: Str, destination_path: Str, overwrite: Bool): Unit =
    std.io.fs.move_file(root, source_path, destination_path, overwrite);
