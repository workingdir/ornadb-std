// Environment access is an explicit host effect and requires a per-name
// allowlist. Names use [A-Z_][A-Z0-9_]*. `get` returns null only for an
// approved unset variable; `require` reports an ordinary missing-variable
// error. No enumeration or mutation API is exposed, and secret material uses
// a separate secret-reference capability.

pub fn get(name: Str): Str? = __get(name);
fn __get(name: Str): Str? = std.io.environment.get(name);

pub fn require(name: Str): Str = __require(name);
fn __require(name: Str): Str = std.io.environment.require(name);
