// Standard Base64 uses the RFC 4648 alphabet with required `=` padding and no
// inserted whitespace. Decoding rejects invalid characters, noncanonical
// padding, and nonzero unused trailing bits. URL-safe Base64 is a separate
// profile and is not silently accepted here.

pub fn encode(input: Blob): Str = __encode(input);
fn __encode(input: Blob): Str =
    fail(error(
        code: "ORNA-EVAL-UNSUPPORTED",
        message: "std.encoding.base64.encode is a native intrinsic"
    ));

pub fn decode(input: Str): Blob = __decode(input);
fn __decode(input: Str): Blob =
    fail(error(
        code: "ORNA-EVAL-UNSUPPORTED",
        message: "std.encoding.base64.decode is a native intrinsic"
    ));
