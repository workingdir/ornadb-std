// std.text pins Unicode 16.0.0 behavior as ordinary library exports. Any
// positions and lengths exposed by text operations count Unicode scalar values,
// not UTF-8 bytes or grapheme clusters. trim removes the pinned Unicode
// White_Space set at both ends and preserves all interior scalars.
//
// Full casing and canonical normalization use Unicode 16.0.0 tables and are
// locale independent; lower applies the contextual Final_Sigma rule.
// normalise accepts the explicit forms NFC and NFD. Split preserves empty
// fields at either edge and between adjacent separators; an empty separator
// yields one field per Unicode scalar (and no fields for empty input). Replace
// is non-overlapping and scans left to right.
pub fn unicode_version(): Str = "16.0.0";

// Private leaves route public source exports through the evaluator primitives
// registered for this pinned Unicode profile. The Rust toolchain's Unicode
// version does not replace the captured behavior.
fn __trim(value: Str): Str = std.text.trim(value);
fn __split(value: Str, separator: Str): [Str] = std.text.split(value, separator);
fn __join(values: [Str], separator: Str): Str = std.text.join(values, separator);
fn __starts_with(value: Str, prefix: Str): Bool = std.text.starts_with(value, prefix);
fn __ends_with(value: Str, suffix: Str): Bool = std.text.ends_with(value, suffix);
fn __contains(value: Str, needle: Str): Bool = std.text.contains(value, needle);
fn __replace(value: Str, from: Str, to: Str): Str = std.text.replace(value, from, to);
fn __normalise(value: Str, form: Str): Str = std.text.normalise(value, form);
fn __lower(value: Str): Str = std.text.lower(value);
fn __upper(value: Str): Str = std.text.upper(value);

pub fn trim(value: Str): Str = __trim(value);
pub fn split(value: Str, separator: Str): [Str] = __split(value, separator);
pub fn join(values: [Str], separator: Str): Str = __join(values, separator);
pub fn starts_with(value: Str, prefix: Str): Bool = __starts_with(value, prefix);
pub fn ends_with(value: Str, suffix: Str): Bool = __ends_with(value, suffix);
pub fn contains(value: Str, needle: Str): Bool = __contains(value, needle);
pub fn replace(value: Str, from: Str, to: Str): Str = __replace(value, from, to);
pub fn normalise(value: Str, form: Str): Str = __normalise(value, form);
pub fn lower(value: Str): Str = __lower(value);
pub fn upper(value: Str): Str = __upper(value);
