// These declarations pin the statistics and aggregation surface. Numeric
// aggregates accept homogeneous Int, Decimal, Float, or dimension-compatible
// quantity inputs. Float aggregates preserve input order, and Float sorting
// uses IEEE-754 totalOrder. Exact Decimal arithmetic stays exact; a
// nonterminating quotient or irrational square root requires explicit scale
// and rounding. Affine absolute quantities follow the aggregation algebra:
// sum is rejected, mean is translated through a selected input base, range
// and standard deviation return deltas, and variance returns a squared delta.
//
// Histogram bins are ordered, nonoverlapping [lower, upper) ranges. Only the
// final upper bound may be made inclusive. Time-series operations require
// strictly increasing timestamps; equal adjacent timestamps fail rather than
// selecting an implicit rate or area. `rate` returns endpoint change per
// elapsed time, `derivative` returns each adjacent slope timestamped at the
// right endpoint, and `integrate` uses trapezoidal integration (value × time).
// Exact integer, Decimal, and Float arithmetic is provided through these
// private evaluator primitives. Public aggregate calls are ordinary source
// functions and use only the operation registered by this captured snapshot.
fn __mean<T>(rows: [T], scale: Int?, rounding: Str?): T? = mean(rows, scale, rounding);
fn __median<T>(rows: [T], scale: Int?, rounding: Str?): T? = median(rows, scale, rounding);
fn __percentile<T, P>(
    rows: [T], p: P, interpolation: Str, scale: Int?, rounding: Str?
): T? = percentile(rows, p, interpolation, scale, rounding);
fn __sum<T>(rows: [T]): T = sum(rows);
fn __min<T>(rows: [T]): T? = min(rows);
fn __max<T>(rows: [T]): T? = max(rows);
fn __range<T>(rows: [T]): T? = range(rows);
fn __mode<T>(rows: [T]): [T] = mode(rows);
fn __variance<T>(rows: [T], scale: Int?, rounding: Str?): T? = variance(rows, scale, rounding);
fn __standard_deviation<T>(rows: [T], scale: Int?, rounding: Str?): T? = standard_deviation(rows, scale, rounding);
fn __histogram<T>(rows: [T], bins: [(T, T)], include_final_upper: Bool): [Int] = histogram(rows, bins, include_final_upper);
fn __rate<T>(points: [(Instant, T)]): T? = rate(points);
fn __derivative<T>(points: [(Instant, T)]): [(Instant, T)] = derivative(points);
fn __integrate<T>(points: [(Instant, T)]): T? = integrate(points);
pub fn mean<T>(
    rows: [T],
    scale: Int? = null,
    rounding: Str? = null
): T? = __mean(rows, scale, rounding);

pub fn median<T>(
    rows: [T],
    scale: Int? = null,
    rounding: Str? = null
): T? = __median(rows, scale, rounding);

pub fn percentile<T, P>(
    rows: [T],
    p: P,
    interpolation: Str,
    scale: Int? = null,
    rounding: Str? = null
): T? = __percentile(rows, p, interpolation, scale, rounding);

// Empty sum is the additive zero. Summing affine absolute quantities is
// invalid; summing linear or delta quantities preserves their dimensions.
pub fn sum<T>(rows: [T]): T = __sum(rows);

// Empty selection aggregates return null. Float min/max use the canonical
// NaN rule when any NaN is present; otherwise min selects -0.0 and max +0.0
// when both signed zeros occur.
pub fn min<T>(rows: [T]): T? = __min(rows);

pub fn max<T>(rows: [T]): T? = __max(rows);

// Range is max - min and returns a delta for affine absolute quantities.
pub fn range<T>(rows: [T]): T? = __range(rows);

// Every mode is returned once, ordered by first appearance in the input.
// Empty input has no modes.
pub fn mode<T>(rows: [T]): [T] = __mode(rows);

// Variance is the population variance (sum of squared deltas divided by n).
// Empty input returns null. A sample estimate is a separately named API and
// is not silently substituted.
pub fn variance<T>(
    rows: [T],
    scale: Int? = null,
    rounding: Str? = null
): T? = __variance(rows, scale, rounding);

// Exact square roots are preserved. An inexact result requires explicit
// scale and rounding, and the result has the input's delta dimension.
pub fn standard_deviation<T>(
    rows: [T],
    scale: Int? = null,
    rounding: Str? = null
): T? = __standard_deviation(rows, scale, rounding);

// Each bin is (inclusive lower bound, exclusive upper bound). The optional
// flag applies only to the final bin's upper bound. Rows outside all bins are
// omitted from the returned per-bin counts.
pub fn histogram<T>(
    rows: [T],
    bins: [(T, T)],
    include_final_upper: Bool = false
): [Int] = __histogram(rows, bins, include_final_upper);

// A series has at least two points for rate/derivative/integration. All
// timestamps must be strictly increasing; equal timestamps are an error.
// Rate and derivative have value/time dimensions; integration has
// value×time dimensions and rejects affine absolute input values.
pub fn rate<T>(points: [(Instant, T)]): T? = __rate(points);

pub fn derivative<T>(points: [(Instant, T)]): [(Instant, T)] = __derivative(points);

pub fn integrate<T>(points: [(Instant, T)]): T? = __integrate(points);
