// These declarations pin the bounded statistics exports. Each operation
// accepts homogeneous Int, Decimal, or Float inputs and observes input order
// for Float aggregation. Mean returns null on empty input. Exact inputs keep
// exact sums; a nonterminating quotient requires explicit scale and rounding.
// Float ordering uses totalOrder where sorting is required. Percentile
// requires p in [0, 1] and a named interpolation method rather than a host
// default.
pub fn mean<T>(
    rows: [T],
    scale: Int? = null,
    rounding: Str? = null
): T? = fail(error(
    code: "ORNA-EVAL-UNSUPPORTED",
    message: "std.stats.mean requires its evaluator binding"
));

pub fn median<T>(
    rows: [T],
    scale: Int? = null,
    rounding: Str? = null
): T? = fail(error(
    code: "ORNA-EVAL-UNSUPPORTED",
    message: "std.stats.median requires its evaluator binding"
));

pub fn percentile<T, P>(
    rows: [T],
    p: P,
    interpolation: Str,
    scale: Int? = null,
    rounding: Str? = null
): T? = fail(error(
    code: "ORNA-EVAL-UNSUPPORTED",
    message: "std.stats.percentile requires its evaluator binding"
));
