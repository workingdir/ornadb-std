// Stream values may wait, checkpoint or perform provider work. Importing this
// module is inert. These declarations pin the standard API; the admitted
// runtime supplies each operator's waiting, ownership and checkpoint binding.

// Construct a finite replayable source without I/O. The captured source
// identity combines this label with the canonical typed digest of all values,
// so reusing a label for different contents cannot resume an old position.
pub fn from_list<T>(values: [T], source_identity: Str): Stream<T> =
    Stream.from_list(values, source_identity);

// Construct a replayable finite source and emit ordered positive-size batches.
// The source identity remains bound to the complete typed value list, and a
// final short batch is retained rather than dropped.
pub fn from_list_batches<T>(
    values: [T],
    source_identity: Str,
    batch_size: Int
): Stream<[T]> = std.stream.batch(
    std.stream.from_list(values, source_identity),
    batch_size
);

// Process one item at a time. Each callback and checkpoint movement is one
// activation; exhaustion returns Unit. Callback failure and cancellation
// propagate without advancing past an uncommitted item.
pub fn for_each<T>(stream: Stream<T>, action: fn(T): Unit): Unit =
    std.stream.for_each(stream, action);

// Emit ordered groups of at most `size`; size must be positive. The final
// group may be shorter, and its checkpoint commits with the whole batch.
pub fn batch<T>(stream: Stream<T>, size: Int): Stream<[T]> = std.stream.batch(stream, size);

// Use a bounded queue with positive capacity and default backpressure. This
// operator never drops an item to make room.
pub fn buffer<T>(stream: Stream<T>, capacity: Int): Stream<T> =
    std.stream.buffer(stream, capacity);

// Interleave by observed arrival order while preserving each input's order.
// Order between independent sources is nondeterministic and not assertable.
pub fn merge<T>(streams: [Stream<T>]): Stream<T> = std.stream.merge(streams);

// Emit at most one item per positive elapsed interval. The caller records an
// explicit policy for dropping deliveries before admitting a nonreplayable
// source; no implicit policy is selected.
pub fn throttle<T>(stream: Stream<T>, duration: Duration, drop_policy: Str): Stream<T> =
    std.stream.throttle(stream, duration, drop_policy);

// Retain the latest item until a positive quiet interval elapses. The caller
// records the delivery policy because intermediate items are intentionally
// coalesced and are not durable processing of every input.
pub fn debounce<T>(stream: Stream<T>, duration: Duration, delivery_policy: Str): Stream<T> =
    std.stream.debounce(stream, duration, delivery_policy);

// Retry the same blocked delivery under its provider contract with bounded
// attempts and delays. Exhaustion fails without advancing the checkpoint.
pub fn retry<T>(
    stream: Stream<T>,
    policy: { max_attempts: Int, initial_delay: Duration, max_delay: Duration }
): Stream<T> = std.stream.retry(stream, policy);

// Replace a permitted source/decoding failure with one explicit value. This
// API cannot acknowledge an ordered delivery by silently skipping it.
pub fn recover<T>(stream: Stream<T>, handler: fn(Error): T): Stream<T> =
    std.stream.recover(stream, handler);
