// The intrinsic also exposes one(rows) without a predicate. A default true
// callback keeps that arity visible to ordinary named imports while the
// evaluator binding preserves the distinct zero/multiple cardinality errors.
pub fn one<T>(
    rows: [T],
    predicate: fn(T): Bool = value => true
): T = fail(error(
    code: "ORNA-EVAL-UNSUPPORTED",
    message: "std.collection.one requires its evaluator binding"
));

