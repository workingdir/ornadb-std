// These public signatures identify the portable collection intrinsics. The
// evaluator binds this exact pinned export to its bounded implementation;
// calling a stub without that binding fails closed instead of substituting a
// host collection library. Stream operations stay separate because they own
// waiting, checkpoint and cancellation effects rather than finite values.
// Relation<T> uses the same intrinsic identity as this [T] declaration; the
// semantic/runtime overload is selected from the supplied relation value.
pub fn filter<T>(rows: [T], predicate: fn(T): Bool): [T] = fail(error(
    code: "ORNA-EVAL-UNSUPPORTED",
    message: "std.collection.filter requires its evaluator binding"
));

pub fn map<T, U>(rows: [T], transform: fn(T): U): [U] = fail(error(
    code: "ORNA-EVAL-UNSUPPORTED",
    message: "std.collection.map requires its evaluator binding"
));

pub fn flat_map<T, U>(rows: [T], transform: fn(T): [U]): [U] = fail(error(
    code: "ORNA-EVAL-UNSUPPORTED",
    message: "std.collection.flat_map requires its evaluator binding"
));

pub fn sort_by<T, K>(rows: [T], key: fn(T): K): [T] = fail(error(
    code: "ORNA-EVAL-UNSUPPORTED",
    message: "std.collection.sort_by requires its evaluator binding"
));

