// The portable profile uses a fixed English compact unit spelling when no
// context is provided; the supplied immutable context is still validated.
pub fn format(
    duration: Duration,
    context: { locale: Str, time_zone: Str } = { locale: "en", time_zone: "UTC" }
): Str = __format(duration, context);
fn __format(
    duration: Duration,
    context: { locale: Str, time_zone: Str }
): Str =
    fail(error(
        code: "ORNA-EVAL-UNSUPPORTED",
        message: "std.time.duration.compact.format is a native intrinsic"
    ));
