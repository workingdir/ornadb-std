// A WebSocket connection is a host-minted UUID identifier scoped to the
// creating activation/session; serializing it grants no access to another
// owner. Operations are cancellation-aware; an owner ending cancels pending
// I/O and joins or fences transport cleanup.
// These external operations are unavailable to assertions, read-only watches,
// presenters, and historical evaluation. Closing or cancelling the transport
// cannot undo messages already delivered to the peer.
// `connect` returns a host-minted UUID bound to the owner. It is an identifier,
// not authority; every operation checks the active owner. Only ws/wss URLs are
// accepted. The `url` must be a canonical std.url.parse result and is
// revalidated before connecting; wss validates the peer certificate and host.
// The server must select one offered subprotocol, or none when none were offered. Header
// validation matches std.net.http. Extensions and compression are not
// negotiated implicitly. timeout is null for no deadline or nonnegative;
// max_handshake_bytes and max_message_bytes must be positive. The URL fragment
// is never sent to the peer.
pub fn connect(
    url: Str,
    headers: [(Str, Str)],
    subprotocols: [Str],
    timeout: Duration?,
    max_handshake_bytes: Int,
    max_message_bytes: Int,
): Uuid = fail(error(
    code: "ORNA-EVAL-UNSUPPORTED",
    message: "std.net.websocket.connect requires its cancellable WebSocket evaluator binding"
));

// `kind` is exactly "text" or "binary". A text payload must be valid UTF-8;
// binary payload bytes are unchanged. Sending a message larger than the
// connection's max_message_bytes fails.
pub fn send(connection: Uuid, kind: Str, payload: Blob): Unit = fail(error(
    code: "ORNA-EVAL-UNSUPPORTED",
    message: "std.net.websocket.send requires its cancellable WebSocket evaluator binding"
));

// Wait for one complete message. Fragmentation is reassembled within the
// configured byte bound. Return null only after an orderly peer close; an
// oversized message fails without returning a prefix.
pub fn receive(connection: Uuid): (Str, Blob)? = fail(error(
    code: "ORNA-EVAL-UNSUPPORTED",
    message: "std.net.websocket.receive requires its cancellable WebSocket evaluator binding"
));

pub fn selected_subprotocol(connection: Uuid): Str? = fail(error(
    code: "ORNA-EVAL-UNSUPPORTED",
    message: "std.net.websocket.selected_subprotocol requires its WebSocket evaluator binding"
));

// Graceful close validates the RFC close-code range and a UTF-8 reason within
// the 123-byte control-frame payload bound. It is idempotent after closure.
pub fn close(connection: Uuid, code: Int, reason: Str): Unit = fail(error(
    code: "ORNA-EVAL-UNSUPPORTED",
    message: "std.net.websocket.close requires its cancellable WebSocket evaluator binding"
));

// Immediate cancellation aborts pending reads/writes and invalidates the
// connection. It cannot retract an application message already sent.
pub fn cancel(connection: Uuid): Bool = fail(error(
    code: "ORNA-EVAL-UNSUPPORTED",
    message: "std.net.websocket.cancel requires its cancellable WebSocket evaluator binding"
));
