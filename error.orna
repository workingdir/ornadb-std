// Language failures use the core Error channel and `|?` recovery boundary.
// These optional helpers construct Error values for explicit failure paths;
// they do not convert a failure into a Result or catch cancellation.

// Preserve the supplied code and message exactly. A newly made Error has no
// causes; callers opt into causal context with `caused_by`.
pub fn make(code: Str, message: Str): Error = error(code: code, message: message);

// Keep the caller's stable top-level code/message and attach exactly the
// supplied Error as the first ordered cause. Its own cause chain stays intact.
pub fn caused_by(code: Str, message: Str, cause: Error): Error = error(
    code: code,
    message: message,
    cause: cause,
);

// Match the stable machine-readable identity. Messages are descriptive and
// may change without changing the error's code.
pub fn matches_code(value: Error, expected: Str): Bool = value.code == expected;

// Return the top-level code followed by cause codes breadth-first, preserving
// the recorded order at each level. This keeps aggregate failures inspectable
// without changing failure propagation or treating Error as a Result value.
fn append_cause_codes(remaining: [Error], collected: [Str]): [Str] =
    case std.collection.first(remaining) {
        Some(current): append_cause_codes(
            std.collection.union(
                std.collection.drop(remaining, 1),
                current.causes
            ),
            std.collection.union(collected, [current.code])
        ),
        null: collected,
    };

pub fn code_chain(value: Error): [Str] =
    append_cause_codes(value.causes, [value.code]);
