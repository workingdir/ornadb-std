// Search helpers operate on finite lists sorted in ascending key order. The
// key must have a lawful total order whose equality agrees with ordering.
use collection;

fn lower_bound_range<T, K>(
    values: [T], target: K, key: fn(T): K, low: Int, high: Int
): Int =
    if low >= high {
        low
    } else {
        let middle = low + ((high - low) / 2);
        if key(values[middle]) < target {
            lower_bound_range(values, target, key, middle + 1, high)
        } else {
            lower_bound_range(values, target, key, low, middle)
        }
    };

fn upper_bound_range<T, K>(
    values: [T], target: K, key: fn(T): K, low: Int, high: Int
): Int =
    if low >= high {
        low
    } else {
        let middle = low + ((high - low) / 2);
        if key(values[middle]) <= target {
            upper_bound_range(values, target, key, middle + 1, high)
        } else {
            upper_bound_range(values, target, key, low, middle)
        }
    };

fn sorted_from<T, K>(values: [T], key: fn(T): K, index: Int, end: Int): Bool =
    if index + 1 >= end {
        true
    } else {
        key(values[index]) <= key(values[index + 1]) &&
            sorted_from(values, key, index + 1, end)
    };

// Duplicate keys insert before the first equal value.
pub fn lower_bound<T, K>(values: [T], target: K, key: fn(T): K): Int =
    lower_bound_range(values, target, key, 0, std.collection.count(values));

// Duplicate keys insert after the last equal value.
pub fn upper_bound<T, K>(values: [T], target: K, key: fn(T): K): Int =
    upper_bound_range(values, target, key, 0, std.collection.count(values));

// Return the first matching index, or null if the target is absent.
pub fn binary_search<T, K>(values: [T], target: K, key: fn(T): K): Int? {
    let index = lower_bound_range(values, target, key, 0, std.collection.count(values));
    if index < std.collection.count(values) && key(values[index]) == target {
        Some(index)
    } else {
        null
    }
}

pub fn is_sorted_by<T, K>(values: [T], key: fn(T): K): Bool =
    sorted_from(values, key, 0, std.collection.count(values));

// Ties retain their input order, as required by std.collection.sort_by.
pub fn stable_sort_by<T, K>(values: [T], key: fn(T): K): [T] =
    std.collection.sort_by(values, key);
