// Query is the explicitly named finite-collection facade. These ordinary
// Orna functions share the exact collection implementation and therefore keep
// callback order, failures, and stable ordering aligned across both modules.
// Contracts: partition returns (matching, remaining); zip stops at the shorter input; unique keeps each lawful equality class's first occurrence; lawful keys while preserving input order inside each group; adjacent and overlapping pairs; window emits complete windows only; split_when starts a group before a matching item; competition ranks (ties share a rank and later ranks skip tied positions).
use collection;

pub fn filter<T>(rows: [T], predicate: fn(T): Bool): [T] =
    std.collection.filter(rows, predicate);

pub fn map<T, U>(rows: [T], transform: fn(T): U): [U] =
    std.collection.map(rows, transform);

pub fn flat_map<T, U>(rows: [T], transform: fn(T): [U]): [U] =
    std.collection.flat_map(rows, transform);

pub fn sort_by<T, K>(rows: [T], key: fn(T): K): [T] =
    std.collection.sort_by(rows, key);

pub fn take<T>(rows: [T], count: Int): [T] = std.collection.take(rows, count);

pub fn drop<T>(rows: [T], count: Int): [T] = std.collection.drop(rows, count);

pub fn distinct<T>(rows: [T]): [T] = std.collection.distinct(rows);

pub fn union<T>(left: [T], right: [T]): [T] = std.collection.union(left, right);

pub fn count<T>(rows: [T]): Int = std.collection.count(rows);

pub fn first<T>(rows: [T]): T? = std.collection.first(rows);

pub fn one<T>(rows: [T], predicate: fn(T): Bool = value => true): T =
    std.collection.one(rows, predicate);

pub fn sum<T>(rows: [T]): T = std.collection.sum(rows);

pub fn min<T>(rows: [T]): T? = std.collection.min(rows);

pub fn max<T>(rows: [T]): T? = std.collection.max(rows);

pub fn every<T>(rows: [T], predicate: fn(T): Bool): Bool =
    std.collection.every(rows, predicate);

pub fn exists<T>(rows: [T], predicate: fn(T): Bool): Bool =
    std.collection.exists(rows, predicate);

pub fn chunk<T>(values: [T], size: Int): [[T]] =
    std.collection.chunk(values, size);

pub fn flatten<T>(values: [[T]]): [T] = std.collection.flatten(values);

pub fn partition<T>(values: [T], predicate: fn(T): Bool): ([T], [T]) =
    std.collection.partition(values, predicate);

pub fn zip<T, U>(left: [T], right: [U]): [(T, U)] =
    std.collection.zip(left, right);

pub fn zip_exact<T, U>(left: [T], right: [U]): [(T, U)] =
    std.collection.zip_exact(left, right);

pub fn unique<T>(values: [T]): [T] = std.collection.unique(values);

pub fn group_by<T, K>(values: [T], key: fn(T): K): [(K, [T])] =
    std.collection.group_by(values, key);

pub fn pairs<T>(values: [T]): [(T, T)] = std.collection.pairs(values);

pub fn window<T>(values: [T], size: Int, step: Int = 1): [[T]] =
    std.collection.window(values, size, step);

// Section 9 specifies complete positional windows and statistics separately.
// This profile helper computes a mean for each complete window, preserving
// the window's positive size/step checks and the statistic's exactness rules.
pub fn window_mean<T>(values: [T], size: Int, step: Int = 1): [T?] =
    map(window(values, size, step), window_values => std.stats.mean(window_values));

// Probability bounds and interpolation are preserved by the selected stats
// operator for every complete window; no host-default interpolation is added.
pub fn window_percentile<T, P>(
    values: [T],
    size: Int,
    probability: P,
    interpolation: Str,
    step: Int = 1
): [T?] =
    map(
        window(values, size, step),
        window_values => std.stats.percentile(window_values, probability, interpolation)
    );

// The remaining scalar and categorical statistics use the same complete
// positional windows. Exact scale and rounding options are passed through
// unchanged, so each window follows std.stats' explicit arithmetic contract.
pub fn window_sum<T>(values: [T], size: Int, step: Int = 1): [T] =
    map(window(values, size, step), window_values => std.stats.sum(window_values));

pub fn window_median<T>(
    values: [T],
    size: Int,
    step: Int = 1,
    scale: Int? = null,
    rounding: Str? = null
): [T?] =
    map(
        window(values, size, step),
        window_values => std.stats.median(window_values, scale, rounding)
    );

pub fn window_min<T>(values: [T], size: Int, step: Int = 1): [T?] =
    map(window(values, size, step), window_values => std.stats.min(window_values));

pub fn window_max<T>(values: [T], size: Int, step: Int = 1): [T?] =
    map(window(values, size, step), window_values => std.stats.max(window_values));

pub fn window_range<T>(values: [T], size: Int, step: Int = 1): [T?] =
    map(window(values, size, step), window_values => std.stats.range(window_values));

pub fn window_mode<T>(values: [T], size: Int, step: Int = 1): [[T]] =
    map(window(values, size, step), window_values => std.stats.mode(window_values));

pub fn window_variance<T>(
    values: [T],
    size: Int,
    step: Int = 1,
    scale: Int? = null,
    rounding: Str? = null
): [T?] =
    map(
        window(values, size, step),
        window_values => std.stats.variance(window_values, scale, rounding)
    );

pub fn window_standard_deviation<T>(
    values: [T],
    size: Int,
    step: Int = 1,
    scale: Int? = null,
    rounding: Str? = null
): [T?] =
    map(
        window(values, size, step),
        window_values => std.stats.standard_deviation(window_values, scale, rounding)
    );

pub fn window_histogram<T>(
    values: [T],
    size: Int,
    bins: [(T, T)],
    include_final_upper: Bool = false,
    step: Int = 1
): [[Int]] =
    map(
        window(values, size, step),
        window_values => std.stats.histogram(window_values, bins, include_final_upper)
    );

// Time-series statistics operate on complete timestamped windows. The stats
// functions retain strict timestamp ordering and their value/time or
// value×time result units; derivative timestamps remain each pair's right end.
// Validate the source series before splitting it into windows: when step is
// larger than one, per-window checks alone can miss a reversal at a boundary.
fn ordered_time_series<T>(points: [(Instant, T)]): [(Instant, T)] =
    if every(pairs(points), pair => pair[0][0] < pair[1][0]) {
        points
    } else {
        fail(error(
            code: "ORNA-EVAL-VALUE",
            message: "time-series timestamps must be strictly increasing"
        ))
    };

pub fn window_rate<T>(
    points: [(Instant, T)],
    size: Int,
    step: Int = 1
): [T?] =
    map(
        window(ordered_time_series(points), size, step),
        window_points => std.stats.rate(window_points)
    );

pub fn window_derivative<T>(
    points: [(Instant, T)],
    size: Int,
    step: Int = 1
): [[(Instant, T)]] =
    map(
        window(ordered_time_series(points), size, step),
        window_points => std.stats.derivative(window_points)
    );

pub fn window_integrate<T>(
    points: [(Instant, T)],
    size: Int,
    step: Int = 1
): [T?] =
    map(
        window(ordered_time_series(points), size, step),
        window_points => std.stats.integrate(window_points)
    );

// Produces consecutive nonempty groups; each matching item starts a new group.
pub fn split_when<T>(values: [T], predicate: fn(T): Bool): [[T]] =
    std.collection.split_when(values, predicate);

pub fn rank<T, K>(values: [T], key: fn(T): K): [(T, Int)] =
    std.collection.rank(values, key);

pub fn asof_join<T, Time, Key>(
    left: [T], right: [T], time: fn(T): Time, by: fn(T): Key
): [(T, T?)] = std.collection.asof_join(left, right, time, by);

pub fn bucket_by<T, P>(rows: [T], period: P, zone: Str): [[T]] =
    std.collection.bucket_by(rows, period, zone);

// Section 9 does not prescribe a query-plan hint API. This profile exposes the
// planner's structured, snapshot-pinned plan so callers can inspect its chosen
// operators and estimate assumptions without parsing rendered explain text.
pub fn plan_hint<T>(query: Query<T>): sys.Plan = sys.explain(query);
