// The reference library permits std.query to re-export portable collection
// intrinsics. Source declarations record the pinned public API; the evaluator
// maps these exact exports to the same intrinsic identities as std.collection
// so pipelines, order, failures, effects and resource bounds cannot diverge.
// Stream<T> operators are deliberately not aliases of these finite collection
// intrinsics: they have distinct waiting/checkpoint identities under
// std.stream, so the evaluator never coerces a stream through a list operator.
// Relation<T> selects the shared intrinsic overload from its input value.
pub fn filter<T>(rows: [T], predicate: fn(T): Bool): [T] = fail(error(
    code: "ORNA-EVAL-UNSUPPORTED",
    message: "std.query.filter requires its evaluator binding"
));

pub fn map<T, U>(rows: [T], transform: fn(T): U): [U] = fail(error(
    code: "ORNA-EVAL-UNSUPPORTED",
    message: "std.query.map requires its evaluator binding"
));

pub fn flat_map<T, U>(rows: [T], transform: fn(T): [U]): [U] = fail(error(
    code: "ORNA-EVAL-UNSUPPORTED",
    message: "std.query.flat_map requires its evaluator binding"
));

