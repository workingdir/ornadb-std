use std.collection;
use std.format;
use std.parse;
use std.text;

// Numeric conversions are locale independent. Exact conversions stay in
// base-ten arithmetic and never pass through binary Float.

/// Parses the canonical signed Int spelling. Invalid or noncanonical input
/// returns null; accepted values contain no plus sign, whitespace,
/// separators, redundant leading zeroes, or negative zero.
pub fn integer_from_text(input: Str): Int? = std.parse.integer(input);

/// Formats an Int as minimal signed base-ten text. Parsing that text with
/// `integer_from_text` recovers the original integer exactly.
pub fn integer_to_text(value: Int): Str = std.format.integer(value);

/// Converts an Int to Decimal exactly by preserving its integer value in
/// base-ten arithmetic, without a binary Float intermediate.
pub fn decimal_from_integer(value: Int): Decimal = value.decimal;

fn digit_value(character: Str): Int? = case character {
    "0": Some(0),
    "1": Some(1),
    "2": Some(2),
    "3": Some(3),
    "4": Some(4),
    "5": Some(5),
    "6": Some(6),
    "7": Some(7),
    "8": Some(8),
    "9": Some(9),
    _: null,
};

/// Parses canonical fixed-point base-ten text into an exact Decimal. A minus
/// sign is optional; a fractional part must contain digits and cannot end in
/// zero. Plus signs, exponent notation, separators, whitespace, redundant
/// leading zeroes, and negative zero return null. No rounding is performed.
/// Inputs beyond evaluator resource limits propagate its bounded limit error.
pub fn decimal_from_text(input: Str): Decimal? {
    let characters = std.text.split(input, "");
    let length = std.collection.count(characters);
    if length == 0 {
        null
    } else {
        let negative = characters[0] == "-";
        let sign_offset = if negative { 1 } else { 0 };
        let point = -1;
        let scan = sign_offset;
        while scan < length && point < 0 {
            if characters[scan] == "." {
                point = scan;
            } else {
                scan += 1;
            };
        };
        let integer_end = if point < 0 { length } else { point };
        let fraction_start = if point < 0 { length } else { point + 1 };
        let integer_text = std.text.join(
            std.collection.take(
                std.collection.drop(characters, sign_offset),
                integer_end - sign_offset
            ),
            ""
        );
        let integer_part = std.parse.integer(integer_text);
        let has_fraction = point >= 0;
        let valid = integer_end > sign_offset
            && integer_part != null
            && (!has_fraction || fraction_start < length)
            && (!has_fraction || characters[length - 1] != "0");
        let fraction_numerator = 0;
        let denominator = 1;
        let index = fraction_start;
        while index < length && valid {
            let digit = case digit_value(characters[index]) {
                Some(value): value,
                null: -1,
            };
            if digit < 0 {
                valid = false;
            } else {
                fraction_numerator = fraction_numerator * 10 + digit;
                denominator = denominator * 10;
            };
            index += 1;
        };
        let integer_value = case integer_part {
            Some(value): value,
            null: 0,
        };
        let fraction = fraction_numerator.decimal / denominator.decimal;
        let magnitude = integer_value.decimal + fraction;
        if valid && !(negative && magnitude == 0.decimal) {
            Some(if negative { -magnitude } else { magnitude })
        } else {
            null
        }
    }
}
// Numeric capabilities are explicit protocols. They do not coerce values or
// route through Float; an implementation owns the arithmetic of its type.
// `Compare.compare` returns a negative value, zero, or a positive value.
// `Integer.div_rem` uses Euclidean division: the remainder is non-negative
// and smaller than the divisor's magnitude. Division by zero fails.

pub protocol Zero {
    fn is_zero(self): Bool;
}

pub protocol One {
    fn is_one(self): Bool;
}

pub protocol Add {
    fn add(self, right: Self): Self;
}

pub protocol Sub {
    fn sub(self, right: Self): Self;
}

pub protocol Mul {
    fn mul(self, right: Self): Self;
}

pub protocol Div {
    fn div(self, right: Self): Self;
}

pub protocol Rem {
    fn rem(self, right: Self): Self;
}

pub protocol Neg {
    fn neg(self): Self;
}

pub protocol Signed {
    fn abs(self): Self;
    fn signum(self): Self;
    fn is_positive(self): Bool;
    fn is_negative(self): Bool;
}

pub protocol Integer {
    fn div_rem(self, divisor: Self): (Self, Self);
}

pub protocol Compare {
    fn compare(self, right: Self): Int;
}

pub fn is_zero<T impl Zero>(value: T): Bool = value.is_zero();

pub fn is_one<T impl One>(value: T): Bool = value.is_one();

pub fn add<T impl Add>(left: T, right: T): T = left.add(right);

pub fn sub<T impl Sub>(left: T, right: T): T = left.sub(right);

pub fn mul<T impl Mul>(left: T, right: T): T = left.mul(right);

pub fn div<T impl Div>(left: T, right: T): T = left.div(right);

pub fn rem<T impl Rem>(left: T, right: T): T = left.rem(right);

pub fn neg<T impl Neg>(value: T): T = value.neg();

pub fn abs<T impl Signed>(value: T): T = value.abs();

pub fn signum<T impl Signed>(value: T): T = value.signum();

pub fn is_positive<T impl Signed>(value: T): Bool = value.is_positive();

pub fn is_negative<T impl Signed>(value: T): Bool = value.is_negative();

pub fn div_rem<T impl Integer>(left: T, right: T): (T, T) = left.div_rem(right);

fn gcd_euclidean<T impl Integer + Zero + Signed>(left: T, right: T): T {
    if right.is_zero() {
        left.abs()
    } else {
        let (_, remainder) = left.div_rem(right);
        gcd_euclidean(right, remainder)
    }
}

/// Returns the non-negative greatest common divisor. Both-zero inputs return
/// zero. Integer implementations must provide Euclidean remainders through
/// `div_rem`; division by zero is avoided by the terminating zero check.
pub fn gcd<T impl Integer + Zero + Signed>(left: T, right: T): T =
    gcd_euclidean(left, right);

/// Returns the least common multiple of the absolute input magnitudes, or
/// zero when either input is zero. Division is exact and nonzero; bounded
/// implementations inherit their `Div` and `Mul` overflow behavior.
pub fn lcm<T impl Integer + Zero + Signed + Div + Mul>(left: T, right: T): T =
    if left.is_zero() {
        left
    } else {
        if right.is_zero() {
            right
        } else {
            (left.abs().div(gcd(left, right))).mul(right.abs())
        }
    };

pub fn min<T impl Compare>(left: T, right: T): T =
    if left.compare(right) <= 0 { left } else { right };

pub fn max<T impl Compare>(left: T, right: T): T =
    if left.compare(right) >= 0 { left } else { right };

pub fn clamp<T impl Compare>(value: T, lower: T, upper: T): T =
    if value.compare(lower) < 0 {
        lower
    } else {
        if value.compare(upper) > 0 { upper } else { value }
    };
