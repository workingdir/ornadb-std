// Composed helpers keep std.parse's primitive spellings strict. Delimited
// lists preserve empty fields, so a leading, trailing, or repeated separator
// makes the entire parse fail. Empty input represents an empty list.
use collection;
use parse;
use text;

fn parse_integer_fields(fields: [Str]): [Int]? {
    let values = [];
    let index = 0;
    let valid = true;
    while index < collection.count(fields) && valid {
        let (field_valid, value) = case parse.integer(fields[index]) {
            Some(value): (true, value),
            null: (false, 0),
        };
        if field_valid {
            values = collection.union(values, [value]);
        } else {
            valid = false;
        };
        index = index + 1;
    };
    if valid { Some(values) } else { null }
}

fn parse_boolean_fields(fields: [Str]): [Bool]? {
    let values = [];
    let index = 0;
    let valid = true;
    while index < collection.count(fields) && valid {
        let (field_valid, value) = case parse.boolean(fields[index]) {
            Some(value): (true, value),
            null: (false, false),
        };
        if field_valid {
            values = collection.union(values, [value]);
        } else {
            valid = false;
        };
        index = index + 1;
    };
    if valid { Some(values) } else { null }
}

/// Returns the parsed canonical integer, or `fallback` when parsing fails.
pub fn integer_or(input: Str, fallback: Int): Int =
    case parse.integer(input) {
        Some(value): value,
        null: fallback,
    };

/// Returns the parsed lowercase boolean, or `fallback` when parsing fails.
pub fn boolean_or(input: Str, fallback: Bool): Bool =
    case parse.boolean(input) {
        Some(value): value,
        null: fallback,
    };

/// Parses a delimited list of canonical integers as one all-or-nothing value.
/// Empty input is `Some([])`. An empty separator or any empty/invalid field
/// returns null; the delimiter is a literal string, not a pattern.
pub fn integer_list(input: Str, separator: Str): [Int]? =
    if separator == "" {
        null
    } else if input == "" {
        Some([])
    } else {
        parse_integer_fields(text.split(input, separator))
    };

/// Parses a delimited list of lowercase booleans as one all-or-nothing value.
/// Empty input is `Some([])`. An empty separator or any empty/invalid field
/// returns null.
pub fn boolean_list(input: Str, separator: Str): [Bool]? =
    if separator == "" {
        null
    } else if input == "" {
        Some([])
    } else {
        parse_boolean_fields(text.split(input, separator))
    };

/// Splits at the first literal separator, returning the complete remainder
/// after it. Missing and empty separators return null; either side may be empty.
pub fn split_once(input: Str, separator: Str): (Str, Str)? =
    if separator == "" {
        null
    } else {
        let fields = text.split(input, separator);
        if collection.count(fields) < 2 {
            null
        } else {
            Some((fields[0], text.join(collection.drop(fields, 1), separator)))
        }
    };
