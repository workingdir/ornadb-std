// Exact settlement helpers. The amount's decimal precision is retained until
// a caller explicitly supplies the currency minor-unit scale and rounding
// rule. `half_even` rounds ties to the even minor unit, `half_up` rounds ties
// away from zero, `toward_zero` truncates, `away_from_zero` expands, `floor`
// rounds toward negative infinity, and `ceil` rounds toward positive infinity.
// Allocation uses the exact integer minor-unit method specified by
// ORNA-MONEY-006. Formatting takes a currency code, minor-unit scale,
// rounding rule and explicit locale; symbols, grouping and decimal marks come
// from this captured locale profile.

pub fn quantize<T>(amount: T, minor_digits: Int, rounding: Str): T =
    __quantize(amount, minor_digits, rounding);

fn __quantize<T>(amount: T, minor_digits: Int, rounding: Str): T =
    quantize(amount, minor_digits, rounding);

pub fn allocate<T>(
    amount: T,
    weights: [Int],
    minor_digits: Int,
    rounding: Str? = null
): [T] = __allocate(amount, weights, minor_digits, rounding);

fn __allocate<T>(
    amount: T,
    weights: [Int],
    minor_digits: Int,
    rounding: Str?
): [T] = allocate(amount, weights, minor_digits, rounding);

pub fn format<T>(
    amount: T,
    currency_code: Str,
    minor_digits: Int,
    rounding: Str,
    locale: Str
): Str = __format(amount, currency_code, minor_digits, rounding, locale);

fn __format<T>(
    amount: T,
    currency_code: Str,
    minor_digits: Int,
    rounding: Str,
    locale: Str
): Str = format(amount, currency_code, minor_digits, rounding, locale);
