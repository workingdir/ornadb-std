// The evaluator profile embeds this immutable time-zone edition. Keeping its
// identity in ordinary pinned source lets old snapshots reject runtime data
// they did not capture instead of silently borrowing the current edition.
pub fn timezone_data_version(): Str = "orna-iana-2024a";

// `zone` is an IANA identifier interpreted using this captured edition.
// Offsets are signed seconds east of UTC at the requested Instant; callers
// always supply a zone and never inherit a process-local default.
pub fn offset_at(instant: Instant, zone: Str): Int = __offset_at(instant, zone);
fn __offset_at(instant: Instant, zone: Str): Int = offset_at(instant, zone);

// `local` is ISO civil text without an offset: YYYY-MM-DDTHH:MM:SS with an
// optional 1..9 digit fractional second. `ambiguous` must explicitly be
// "earlier", "later", or "reject". The first two choices select an overlap
// occurrence; "reject" accepts only unique local times. Nonexistent local
// times fail because this profile has no named gap-adjustment policy.
pub fn resolve_local(local: Str, zone: Str, ambiguous: Str): Instant = __resolve_local(local, zone, ambiguous);
fn __resolve_local(local: Str, zone: Str, ambiguous: Str): Instant = resolve_local(local, zone, ambiguous);

// Keep the four elapsed-duration presentations reachable from std.time. Their
// sources are separate pinned modules, so a snapshot captures each formatter
// independently and cannot acquire one from an installed library later.
// Elapsed decimal unit literals must resolve exactly to core nanoseconds;
// calendar day periods stay distinct and cannot be formatted as elapsed time.
// Gregorian civil-date helpers are source-level functions with no zone or
// elapsed-clock dependency.
use std.time.calendar as calendar;
use std.time.duration.compact;
use std.time.duration.clock;
use std.time.duration.words;
use std.time.duration.iso;
