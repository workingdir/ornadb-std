// `T?` is the language's built-in Option<T>, represented by Some(value) or
// null. This module adds ordinary helpers without changing that core type or
// turning language failures into optional values.
pub fn is_some<T>(value: T?): Bool = case value {
    Some(_): true,
    null: false,
};

pub fn is_none<T>(value: T?): Bool = case value {
    Some(_): false,
    null: true,
};

pub fn map<T, U>(value: T?, transform: fn(T): U): U? = case value {
    Some(inner): Some(transform(inner)),
    null: null,
};

pub fn and_then<T, U>(value: T?, transform: fn(T): U?): U? = case value {
    Some(inner): transform(inner),
    null: null,
};

pub fn filter<T>(value: T?, predicate: fn(T): Bool): T? = case value {
    Some(inner) if predicate(inner): Some(inner),
    Some(_): null,
    null: null,
};

pub fn unwrap_or<T>(value: T?, fallback: T): T = case value {
    Some(inner): inner,
    null: fallback,
};

pub fn or_else<T>(value: T?, fallback: fn(): T?): T? = case value {
    Some(inner): Some(inner),
    null: fallback(),
};

pub fn zip<T, U>(left: T?, right: U?): (T, U)? = case left {
    Some(left_value): case right {
        Some(right_value): Some((left_value, right_value)),
        null: null,
    },
    null: null,
};

pub fn to_list<T>(value: T?): [T] = case value {
    Some(inner): [inner],
    null: [],
};
